{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:main": "node server-main.js",
    "start:interview": "node server-interview.js",
    "dev": "nodemon server.js",
    "worker:interview": "node workers/interviewWorker.js",
    "worker:execution": "node workers/executionWorker.js",
    "score:calibrate": "node scripts/calibrateInterviewScoring.js",
    "score:calibrate:live": "node scripts/calibrateInterviewScoring.js --live",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --ci --coverage --maxWorkers=2",
    "add-sample-data": "node scripts/addSampleData.js",
    "db:drop-sessions": "node scripts/dropExpressSessionCollection.js",
    "migrate:companies-split": "node scripts/migrate-legacy-companies-copy-to-split.js",
    "migrate:companies-split:dry-run": "node scripts/migrate-legacy-companies-copy-to-split.js --dry-run",
    "backfill:messageDate:visits": "node scripts/backfill-messageDate-to-visits.js",
