    "backfill:mustDoTopics:cse-visits": "node scripts/backfill-must-do-topics-to-cse-visits.js",
    "backfill:mustDoTopics:cse-visits:dry-run": "node scripts/backfill-must-do-topics-to-cse-visits.js --dry-run",
    "seed:gap-interview-questions": "node scripts/seedGapGeneratedInterviewQuestions.js",
    "seed:gap-interview-questions:dry-run": "node scripts/seedGapGeneratedInterviewQuestions.js --dry-run",
    "interview-questions:audit-testcase-dupes": "node scripts/auditInterviewQuestionDuplicateTestCases.js",
    "interview-questions:audit-testcase-dupes:dsa": "node scripts/auditInterviewQuestionDuplicateTestCases.js --round-type=DSA",
    "interview-questions:fix-testcase-dupes": "node scripts/auditInterviewQuestionDuplicateTestCases.js --fix",
    "interview-questions:fix-testcase-dupes:dry-run": "node scripts/auditInterviewQuestionDuplicateTestCases.js --fix --dry-run",
    "seed:dsa-two-two-testcases": "node scripts/seedDsaTwoVisibleTwoHiddenTestCases.js --write-json --fix-mongo",
    "seed:dsa-two-two-testcases:dry-run": "node scripts/seedDsaTwoVisibleTwoHiddenTestCases.js --dry-run --limit=5",
    "seed:dsa-two-two-testcases:json-only": "node scripts/seedDsaTwoVisibleTwoHiddenTestCases.js --write-json",
    "seed:dsa-two-two-testcases:no-llm": "node scripts/seedDsaTwoVisibleTwoHiddenTestCases.js --no-llm --dry-run",
    "interview-questions:assign-company-tags": "node scripts/assignCompanyTagsToInterviewQuestions.js",
    "interview-questions:assign-company-tags:dry-run": "node scripts/assignCompanyTagsToInterviewQuestions.js --dry-run",
    "interview-questions:assign-company-tags-sd": "node scripts/assignCompanyTagsToInterviewQuestions.js --round-types \"System Design\" --first-companies 30",
    "interview-questions:assign-company-tags-sd:dry-run": "node scripts/assignCompanyTagsToInterviewQuestions.js --round-types \"System Design\" --first-companies 30 --dry-run"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.71.1",
    "compute-cosine-similarity": "^1.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "groq-sdk": "^1.1.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "mongodb": "^6.20.0",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "razorpay": "^2.9.6",
    "redis": "^4.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^2.0.22",
    "supertest": "^7.1.4"
  }
